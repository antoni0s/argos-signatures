128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Tt][Ss]*,[Ss][OoKk]*|8|8192|Windows Server|88|server|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Ss][OoKk]*,[Tt][Ss]*|8|8192|Windows Server|86|server|Microsoft

# 2. Semi-Specific (Exact Win or Exact WS)
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Tt][Ss]*,[Ss][OoKk]*|*|8192|Windows Server|84|server|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Tt][Ss]*,[Ss][OoKk]*|8|*|Windows|90|pc|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Ss][OoKk]*,[Tt][Ss]*|8|*|Windows|88|pc|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Ss][OoKk]*|8|*|Windows|86|pc|Microsoft

# 3. Generic Pattern Matches
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Tt][Ss]*,[Ss][OoKk]*|*|*|Windows|88|pc|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Ss][OoKk]*,[Tt][Ss]*|*|*|Windows|86|pc|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Ss][OoKk]*|*|*|Windows|84|pc|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Ss][OoKk]*|*|*|Windows (Legacy)|80|pc|Microsoft
128|^[Mm][Ss0-9]*,[Nn][OoPp]*,[Ww][Ss0-9]*,[Nn][OoPp]*,[Nn][OoPp]*,[Tt][Ss]*,[Ee][OoLl]*|*|*|Windows|78|pc|Microsoft

# 4. TTL 128 Fallback
128|*|*|*|Windows|60|pc|Microsoft



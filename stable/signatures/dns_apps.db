# ==============================================================================
# Database: Application Insights Signatures (DNS App Discovery)
# ------------------------------------------------------------------------------
# Field Schema:
#   Regex Domain | Application Name | Category | Vendor
#
# Rules for Adding Entries:
#   1. Escaped dots (\.) are required for regex accuracy.
#   2. Keep subdomains specific to the application before broader parent domains.
#   3. Ensure exactly 4 fields separated by '|' (no double pipes '||').
#
# DEFAULT_TAXONOMY = [
#     "AI & Machine Learning", "Cloud Infrastructure & Hosting", "Developer & DevOps",
#     "Identity & Security", "IoT & Smart Home", "Telemetry & AdTech",
#     "Business & Productivity", "Communication & Collaboration", "Telecommunications & ISPs",
#     "E-Commerce & Retail", "Finance, Banking & Crypto", "Travel, Transport & Logistics",
#     "Streaming & Media", "News & Journalism", "Gaming & Esports", "Gambling & Betting",
#     "Social Media & Communities", "Government & Public Sector", "Education & Academia",
#     "Health, Fitness & Pharmacy", "Adult & Explicit", "Web & Search Portals",
# ]
#
# Example:
#   chatgpt\.com|ChatGPT|AI & ML Tools|OpenAI
#   netflix\.com|Netflix|Media & Streaming|Netflix
# ==============================================================================

